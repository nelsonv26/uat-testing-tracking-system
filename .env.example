# ─── Jira ────────────────────────────────────────────────────────────────
# Shared secret you set when creating the Jira webhook. Used to validate
# incoming webhook requests. Pick any long random string.
JIRA_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Base URL of your Jira Cloud instance (no trailing slash).
JIRA_BASE_URL=https://adoreal.atlassian.net

# Jira API token + the email of the account that created it.
# Create a token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
JIRA_EMAIL=

# The TEST project key the webhook fires for (e.g. TEST, UAT). Read-only here;
# used to double-check the epic belongs to the expected project.
JIRA_PROJECT_KEY=TEST

# ─── Slack ───────────────────────────────────────────────────────────────
# Bot User OAuth Token (starts with xoxb-). From your Slack app -> OAuth & Permissions.
SLACK_BOT_TOKEN=

# Channel ID of the TEST UAT channel (e.g. C0123456789). NOT the channel name.
SLACK_CHANNEL_ID=

# Comma-separated Slack user IDs of the testers (e.g. U0123,U0456,...).
SLACK_USER_IDS=

# ─── App ─────────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=3000

# Public base URL of THIS app, used to build shareable tester links that go
# into Slack DMs / Canvas (e.g. https://uat.example.com or an ngrok URL).
# No trailing slash. Falls back to http://localhost:PORT if unset.
APP_BASE_URL=

# The exact Jira status name that triggers a UAT cycle.
TRIGGER_STATUS=Ready for UAT
